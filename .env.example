# Root .env — read by docker-compose.yml for the `api` service.
# Copy to `.env` and fill in. Every value here has a safe dev default in
# docker-compose.yml; only BETTER_AUTH_SECRET is mandatory for production.
# See docs/self-hosting.md §3 for details on each group.

# ── Auth (better-auth) ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=                     # 32+ random chars, REQUIRED in prod
BETTER_AUTH_URL=http://localhost:5173    # public origin of the API
BETTER_AUTH_APP_ORIGIN=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=            # comma-separated extra origins (prod)
#BETTER_AUTH_RP_ID=                     # WebAuthn RP ID — registrable apex domain
#BETTER_AUTH_COOKIE_DOMAIN=             # shared cookie domain, e.g. ".example.org"
#BETTER_AUTH_DEV_LAN_ORIGINS=           # dev only: http://<your-lan-ip>:5173

# ── Transactional email for OTP codes (optional; logged to console if unset)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-domain.example
BREVO_SENDER_NAME=Open VFR

# ── Force-update gate (optional) ───────────────────────────────────────────
APP_MIN_VERSION=0.0.0

# ── Live traffic (optional) ────────────────────────────────────────────────
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BBOX=55.0,10.0,69.5,24.5         # south,west,north,east
OPENSKY_POLL_INTERVAL_S=65
OGN_ENABLED=true
OGN_FILTER_LAT=
OGN_FILTER_LON=
OGN_FILTER_RADIUS_KM=350

# ── NOTAM lookup via FAA NMS-API (optional; no self-service signup) ────────
NMS_CLIENT_ID=
NMS_CLIENT_SECRET=
#NMS_AUTH_HOST=
#NMS_API_HOST=

# ── POH PDF auto-fill via Azure OpenAI (optional) ──────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Native passkey / app-link association (optional, prod only) ───────────
#APPLE_TEAM_ID=
#IOS_BUNDLE_ID=org.openvfr.app
#ANDROID_PACKAGE=org.openvfr.app
#ANDROID_SHA256_FINGERPRINT=
#ANDROID_PASSKEY_ORIGIN=               # android:apk-key-hash:<b64url sha256>, comma-separated
