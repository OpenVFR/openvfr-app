# Normalize line endings on checkout for all text files
* text=auto

# Shell scripts must always be LF (CRLF breaks shebangs on Linux/Alpine)
*.sh text eol=lf

# Python scripts — LF in Docker/Linux containers
*.py text eol=lf

# Windows-native files can stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never mangle
*.pmtiles binary
*.mbtiles binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
