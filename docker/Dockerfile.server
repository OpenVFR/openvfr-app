# docker/Dockerfile.server
# ─────────────────────────────────────────────────────────────────────────────
# Builds the openvfr Hono API server (Node.js).
#
# Build context: project root (.)
# ─────────────────────────────────────────────────────────────────────────────
FROM node:26-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216

# Node 25+ no longer bundles Corepack, so install the exact pnpm version the
# root package.json's `packageManager` field pins (never `pnpm@latest`: a new
# major can land there at any time instead of the version the lockfile was
# written with).
COPY package.json /tmp/pm/package.json
RUN npm install -g "pnpm@$(node -p "require('/tmp/pm/package.json').packageManager.split('@')[1].split('+')[0]")" \
 && rm -rf /tmp/pm

WORKDIR /app

# Install via the root workspace — apps/api is a real pnpm workspace member.
# @open-vfr/shared (packages/shared) must be copied here too, BEFORE
# `pnpm install` -- pnpm resolves pnpm-workspace.yaml's `packages/*` glob
# against whatever package.json files actually exist in the build context
# at install time; omitting packages/shared/package.json here means pnpm
# can't see it as a workspace member at all, so apps/api's
# `@open-vfr/shared: workspace:*` dependency silently fails to link even
# though `pnpm install` itself exits 0 (no error, no warning) -- confirmed
# live: ERR_MODULE_NOT_FOUND at runtime, well after a successful build,
# the first time apps/api/src actually imported something from
# @open-vfr/shared (previously zero runtime dependency existed on it, so
# this gap in the Dockerfile never mattered before).
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
# pnpm-workspace.yaml's patchedDependencies are validated at install time
# even for packages the api doesn't use (@expo/ui etc.): files must exist.
COPY patches patches
# Frozen only: a lockfile/manifest mismatch must fail the build loudly, not
# silently re-resolve to whatever versions happen to be current at build time.
RUN pnpm install --frozen-lockfile

# Copy source (tsx runs TypeScript directly — no build step needed).
# packages/shared's exports map points at ./src/*.ts directly (no dist/
# build step for this package either) -- the actual .ts source must be
# present in the image, not just its package.json (which only satisfies
# pnpm's workspace-resolution/symlink step above, not the real import).
COPY apps/api/src apps/api/src
COPY packages/shared/src packages/shared/src

WORKDIR /app/apps/api

# better-auth only turns on its per-IP rate limiter (and a few other
# production-only safety defaults) when NODE_ENV=production. apps/api/src/
# auth.ts also sets rateLimit.enabled explicitly, but keep the env correct
# so any other library's prod/dev switch lands on the right side too.
ENV NODE_ENV=production

# Drop root. The image's built-in unprivileged `node` user owns /app so pnpm's
# node_modules symlinks stay resolvable; /tmp (POH upload staging) and /data
# (NOTAM cache bind mount) must be writable by uid 1000 -- see the compose
# file's tmpfs/volume config in the infra repo.
RUN chown -R node:node /app
USER node

EXPOSE 5200

# tsx's binary is linked into apps/api's own node_modules/.bin/ (pnpm's
# strict, non-hoisted linking puts each workspace member's devDependency
# binaries there, not in the root node_modules/.bin/).
CMD ["node_modules/.bin/tsx", "src/index.ts"]
