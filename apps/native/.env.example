# apps/native/.env — baked into the JS bundle at build time (EXPO_PUBLIC_*).
# Copy to `.env` (or `.env.local` for a local override). `pnpm metro:dev`
# injects localhost values itself; these matter for `metro:prod` / EAS builds.
# See apps/native/README.md "Environment" for precedence rules.

EXPO_PUBLIC_API_BASE=https://api.example.org      # Hono API origin
EXPO_PUBLIC_TILE_BASE=https://tiles.example.org   # static tile host (no trailing /tiles unless your host needs it)
#EXPO_PUBLIC_API_BASE_ANDROID=                    # Android-only override (physical device via adb reverse)
#EXPO_PUBLIC_TRAFFIC_BASE=                        # defaults to API base
#EXPO_PUBLIC_MARTIN_BASE=                         # Martin vector-tile server, defaults to API base
#EXPO_PUBLIC_WEB_BASE=                            # web app origin (share links)
#EXPO_PUBLIC_BASEMAP_URL=                         # dev: local basemap.pmtiles override

# EAS identifiers (see app.config.js) — only needed for `eas build`/`eas update`
#EAS_PROJECT_ID=
#EAS_OWNER=
