    "typecheck": "tsc --noEmit",
    "check:permissions": "node scripts/check-permissions.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "run:android": "expo run:android",
    "build:android:device": "adb reverse tcp:8081 tcp:8081&&adb reverse tcp:5200 tcp:5200&&adb reverse tcp:5174 tcp:5174&&adb reverse tcp:5100 tcp:5100&&expo run:android",
    "run:ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:5200 tcp:5200 && adb reverse tcp:5174 tcp:5174 && adb reverse tcp:5100 tcp:5100 && echo All ports reversed",
    "metro:local": "node scripts/dev-device.mjs --local",
