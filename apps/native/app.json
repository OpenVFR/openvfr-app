{
  "expo": {
    "platforms": [
      "android",
      "ios"
    ],
    "name": "OpenVFR",
    "slug": "open-vfr",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "openvfr",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.openvfr.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ],
        "NSLocationWhenInUseUsageDescription": "OpenVFR needs GPS to show your position on the map and provide in-flight navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OpenVFR needs background GPS access to continue tracking your flight when the screen locks.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "org.openvfr.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#0a0e16"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-sensors",
        { "motionPermission": "OpenVFR uses the barometer (motion sensor) for altitude and vertical speed." }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OpenVFR needs GPS for in-flight navigation.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral"
          ],
          "bluetoothAlwaysPermission": "OpenVFR uses Bluetooth to connect to a BlueFly Vario for barometric altitude and vertical speed."
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-secure-store",
        { "faceIDPermission": false }
      ],
      "./plugins/withMapLibreHttpGuard",
      "./plugins/withMapLibreHttpGuardIos",
      "./plugins/withAndroidLargeHeap",
      "./plugins/withAndroidDisableLintVital",
      "./plugins/withAndroidNativeDebugSymbols",
      "expo-splash-screen"
    ]
  }
}
