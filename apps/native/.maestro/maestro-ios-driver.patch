diff -ruN orig/maestro-driver-iosUITests/Routes/XCTest/RunningApp.swift new/maestro-driver-iosUITests/Routes/XCTest/RunningApp.swift
--- a/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/RunningApp.swift	2026-11-03 23:07:03.618938278 +0100
+++ b/maestro-ios-xctest-runner/maestro-driver-iosUITests/Routes/XCTest/RunningApp.swift	2026-11-03 23:07:03.639643776 +0100
@@ -24,6 +24,17 @@
         } ?? RunningApp.springboardBundleId
     }
     
+    /// Bundle id of the app under test, passed by the host through the
+    /// `TEST_RUNNER_MAESTRO_FOREGROUND_APP` environment variable (xcodebuild strips
+    /// the prefix). On the iPhone Duo simulator (iOS 27.1) `activeAppsInfo()` can
+    /// leave the foreground app out while it is running, focal and on screen; the
+    /// driver then returns SpringBoard's hierarchy and every lookup fails. When set,
+    /// this app is checked directly as a fallback.
+    static let foregroundAppHint: String? = {
+        let v = ProcessInfo.processInfo.environment["MAESTRO_FOREGROUND_APP"] ?? ""
+        return v.isEmpty ? nil : v
+    }()
+
     static func getForegroundApp() -> XCUIApplication? {
         let runningAppIds = XCUIApplication.activeAppsInfo().compactMap { $0["bundleId"] as? String }
         
@@ -34,9 +45,20 @@
         // a splash screen). Snapshotting it then throws "Application ... is not running", which callers
         // escalate as a fatal AppCrash. Returning nil instead lets callers fall back to the springboard hierarchy
         // and retry.
-        return runningAppIds
-            .map { XCUIApplication(bundleIdentifier: $0) }
-            .first { $0.state == .runningForeground }
+        if let app = runningAppIds
+            .map({ XCUIApplication(bundleIdentifier: $0) })
+            .first(where: { $0.state == .runningForeground }) {
+            return app
+        }
+        if let hint = foregroundAppHint, !runningAppIds.contains(hint) {
+            let app = XCUIApplication(bundleIdentifier: hint)
+            if app.state == .runningForeground {
+                NSLog("activeAppsInfo() did not list \(hint) but it is running in the foreground; using it")
+                return app
+            }
+            NSLog("Foreground app hint \(hint) is not in the foreground (state \(app.state.rawValue))")
+        }
+        return nil
     }
     
 }
