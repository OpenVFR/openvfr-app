+    /// Keep serving after an XCTest issue (see IssueReportingHandler).
+    override func record(_ issue: XCTIssue) {
+        XCTestIssues.record(issue)
+    }
+
     override class func tearDown() {
         logger.trace("tearDown")
     }
 }
 
+enum XCTestIssues {
+    private(set) static var count = 0
+    private(set) static var latest = ""
+
+    static func record(_ issue: XCTIssue) {
+        count += 1
+        latest = issue.compactDescription
+        NSLog("Kept serving after XCTest issue: \(latest)")
+    }
+}
