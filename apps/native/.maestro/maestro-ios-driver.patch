+/// iPhone Duo cover-display geometry (see ViewHierarchyHandler.getAppViewHierarchy).
+enum DuoGeometry {
+    /// The app's own interface orientation (UIInterfaceOrientation raw value; 0 = unknown),
+    /// read through KVC like XCTest's own tooling; -1 when unavailable.
+    static func interfaceOrientation(of app: XCUIApplication) -> Int {
+        let object = app as NSObject
+        guard object.responds(to: NSSelectorFromString("interfaceOrientation")),
+              let n = object.value(forKey: "interfaceOrientation") as? NSNumber else { return -1 }
+        return n.intValue
+    }
+
+    /// Rotates a hierarchy whose frames are in a landscape native space (width `nativeWidth`)
+    /// into the upright portrait space: x' = y, y' = nativeWidth - (x + width), sizes swapped.
+    static func rotateUpright(_ element: AXElement, nativeWidth: Double) -> AXElement {
+        let f = element.frame
+        let x = f["X"] ?? 0, y = f["Y"] ?? 0, w = f["Width"] ?? 0, h = f["Height"] ?? 0
+        let frame: AXFrame = ["X": y, "Y": nativeWidth - (x + w), "Width": h, "Height": w]
+        return AXElement(
+            identifier: element.identifier,
+            frame: frame,
+            value: element.value,
+            title: element.title,
+            label: element.label,
+            elementType: element.elementType,
+            enabled: element.enabled,
+            horizontalSizeClass: element.horizontalSizeClass,
+            verticalSizeClass: element.verticalSizeClass,
+            placeholderValue: element.placeholderValue,
+            selected: element.selected,
+            hasFocus: element.hasFocus,
+            displayID: element.displayID,
+            windowContextID: element.windowContextID,
+            children: element.children?.map { rotateUpright($0, nativeWidth: nativeWidth) } ?? []
+        )
+    }
+}
