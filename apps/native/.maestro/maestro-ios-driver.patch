+
+/// An XCTest issue recorded while a request is handled (e.g. a transient
+/// accessibility failure while snapshotting SpringBoard's status bars, see
+/// mobile-dev-inc/Maestro#3538) used to unwind `testHttpServer` and take the
+/// whole driver down. The test case below keeps the issue instead of failing;
+/// this wrapper turns it into an error response for that one request.
+@MainActor
+struct IssueReportingHandler: HTTPHandler {
+    let handler: HTTPHandler
+
+    func handleRequest(_ request: HTTPRequest) async throws -> HTTPResponse {
+        let issues = XCTestIssues.count
+        let response = try await handler.handleRequest(request)
+        return XCTestIssues.count == issues ? response : AppError(message: XCTestIssues.latest).httpResponse
+    }
+}
