# apps/web/.env.local — Vite dev/build env. All optional.
# See apps/web/src/utils/env.ts and vite.config.ts.

#VITE_API_BASE_URL=            # prod build: absolute API origin (default: same origin)
#VITE_TILES_BASE_URL=          # prod build: absolute tile host (default: /tiles)
#VITE_SITE_BASE_URL=           # public site origin serving /privacy and /terms (sign-in footer links; hidden when unset)
#VITE_STATUS_URL=             # operator notices JSON (maintenance/outages), hosted apart from the API; unset = off
#VITE_DEV_API_TARGET=          # dev proxy: point /api/* and /rest at a running API instead of localhost
#VITE_DEV_TILES_TARGET=        # dev proxy: tile host for /tiles. No default: when unset, /tiles is served from the local apps/web/public/tiles/ mirror, which commonly lags the real data
#VITE_DEV_TRAFFIC_TARGET=      # dev proxy: /api/traffic origin (default: VITE_DEV_API_TARGET or hosted instance)
#VITE_DEV_API_ORIGIN=           # dev proxy: with a remote VITE_DEV_API_TARGET, present this origin (the hosted app's own) so its better-auth accepts local sign-in; cookie Domain is stripped. Dev server only.
# Experimental features, off by default (build-time):
#VITE_EXPERIMENTAL_CHARTS=true                    # official chart documents/overlay in the aerodrome popup (needs the api's CHART_DOCUMENT_* settings; admin-only server side when CHART_DOCUMENT_ADMIN_ONLY=1)
#VITE_EXPERIMENTAL_AERODROME_DETAILS=true         # circuits, noise-sensitive areas, holdings from <cc>-aerodrome-details.geojson. Admins can also switch on the unreviewed set in Settings (the .preview.geojson files are public to anyone with the URL)
