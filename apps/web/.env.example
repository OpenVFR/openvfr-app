# apps/web/.env.local — Vite dev/build env. All optional.
# See apps/web/src/utils/env.ts and vite.config.ts.

#VITE_API_BASE_URL=            # prod build: absolute API origin (default: same origin)
#VITE_TILES_BASE_URL=          # prod build: absolute tile host (default: /tiles)
#VITE_DEV_API_TARGET=          # dev proxy: point /api/* and /rest at a running API instead of localhost
#VITE_DEV_TILES_TARGET=        # dev proxy: tile host for /tiles (default: maintainers' hosted instance)
#VITE_DEV_TRAFFIC_TARGET=      # dev proxy: /api/traffic origin (default: VITE_DEV_API_TARGET or hosted instance)
