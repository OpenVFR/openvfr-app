# Dependencies
node_modules/
dist/

# Data files — tile archives and generated data are large, not tracked in git
data/
apps/web/public/tiles/*.pmtiles
apps/web/public/tiles/*.mbtiles
apps/web/public/tiles/*.geojson
apps/web/public/tiles/manifest.json

# Environment
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.prod
.env.local.disabled

# Vite
*.local

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# pnpm
.pnpm-store/

# navigation / chart data intermediates not covered above
*.gpkg
*.geopackage
*.sqlite
*.sqlite3

# mobile signing / provisioning
*.keystore
*.jks
*.p12
*.mobileprovision
*.p8

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo

# React Native / Expo (apps/native/)
# Generated by `npx expo prebuild` — do not commit
apps/native/ios/
apps/native/android/
apps/native/.expo/
apps/native/node_modules/
apps/native/.env
phone_screen.png
device.png
