+/**
+ * [ModalBottomSheet] opens in its own dialog window, and system-bar visibility is per window: an
+ * activity in immersive mode (system bars hidden via WindowInsetsController) gets the status bar,
+ * navigation bar and (on large screens) the taskbar back the moment a sheet opens. Mirror the
+ * activity's state onto the dialog window so a fullscreen app stays fullscreen while a sheet is
+ * up. No-op when the activity shows its bars.
+ *
+ * The activity's state is read once, during the sheet's first composition. That runs before the
+ * dialog window is shown (Material3 composes the sheet content in setContent, then shows the
+ * dialog from an effect), so the activity's insets still describe what the app asked for: once
+ * the dialog has focus and the system shows the bars for it, every window's insets report them
+ * visible and the information is gone. The hide is re-applied whenever the dialog window's insets
+ * report the bars visible again, which covers the system re-showing them after focus changes.
+ */
+@Composable
+private fun MatchActivitySystemBars(activity: Activity?) {
+  val dialogWindow = (LocalView.current.parent as? DialogWindowProvider)?.window ?: return
+  val activityWindow = activity?.window ?: return
+
+  val hiddenTypes = remember(activityWindow) {
+    val insets = ViewCompat.getRootWindowInsets(activityWindow.decorView)
+    var types = 0
+    if (insets != null && !insets.isVisible(WindowInsetsCompat.Type.statusBars())) {
+      types = types or WindowInsetsCompat.Type.statusBars()
+    }
+    if (insets != null && !insets.isVisible(WindowInsetsCompat.Type.navigationBars())) {
+      types = types or WindowInsetsCompat.Type.navigationBars()
+    }
+    Log.i(SYSTEM_BARS_TAG, "activity hides system bar types=$types")
+    types
+  }
+  if (hiddenTypes == 0) {
+    return
+  }
+
+  DisposableEffect(dialogWindow, hiddenTypes) {
+    val decorView = dialogWindow.decorView
+    val controller = WindowCompat.getInsetsController(dialogWindow, decorView)
+    fun hide() {
+      controller.systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+      controller.hide(hiddenTypes)
+    }
+    WindowCompat.setDecorFitsSystemWindows(dialogWindow, false)
+    hide()
+    ViewCompat.setOnApplyWindowInsetsListener(decorView) { view, insets ->
+      // isVisible(mask) is true only when every type in the mask is visible; check them one by one.
+      val reappeared = listOf(WindowInsetsCompat.Type.statusBars(), WindowInsetsCompat.Type.navigationBars())
+        .any { type -> (hiddenTypes and type) != 0 && insets.isVisible(type) }
+      if (reappeared) {
+        Log.i(SYSTEM_BARS_TAG, "dialog window shows hidden system bars again, re-hiding")
+        hide()
+      }
+      // Keep the decor view's own handling (system bar background views, child dispatch).
+      ViewCompat.onApplyWindowInsets(view, insets)
+    }
+    onDispose {
+      ViewCompat.setOnApplyWindowInsetsListener(decorView, null)
+    }
+  }
+}
+
+private const val SYSTEM_BARS_TAG = "ExpoUISheetSystemBars"
