+/**
+ * [ModalBottomSheet] opens in its own dialog window, and system-bar visibility is per window: an
+ * activity in immersive mode (system bars hidden via WindowInsetsController) gets the status bar,
+ * navigation bar and (on large screens) the taskbar back the moment a sheet opens. Mirror the
+ * activity's state onto the dialog window so a fullscreen app stays fullscreen while a sheet is
+ * up. No-op when the activity shows its bars.
+ */
+@Composable
+private fun MatchActivitySystemBars(activity: Activity?) {
+  val dialogWindow = (LocalView.current.parent as? DialogWindowProvider)?.window
+  val activityWindow = activity?.window
+  if (dialogWindow == null || activityWindow == null) {
+    return
+  }
+
+  DisposableEffect(dialogWindow, activityWindow) {
+    val activityInsets = ViewCompat.getRootWindowInsets(activityWindow.decorView)
+    val barsHidden = activityInsets != null && !activityInsets.isVisible(WindowInsetsCompat.Type.systemBars())
+    if (barsHidden) {
+      WindowCompat.setDecorFitsSystemWindows(dialogWindow, false)
+      WindowCompat.getInsetsController(dialogWindow, dialogWindow.decorView).apply {
+        systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+        hide(WindowInsetsCompat.Type.systemBars())
+      }
+    }
+    onDispose { }
+  }
+}
