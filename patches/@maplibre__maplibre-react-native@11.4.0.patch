+    /**
+     * SymbolManager.update() logs "Can't update annotation ... the annotation
+     * isn't active annotation" for a symbol it no longer tracks. That happens
+     * when a callback (deferred style callback, layout change, prop setter)
+     * runs after removeFromMap() deleted the symbol, once per annotation on
+     * every unmount. Only update symbols the manager still holds.
+     */
+    private fun updateSymbol(symbol: Symbol?) {
+        if (symbol == null) return
+        val manager = mMapView?.getSymbolManager() ?: return
+        if (manager.annotations.indexOfValue(symbol) >= 0) {
+            manager.update(symbol)
+        }
+    }
+
     private fun updateOptions() {
